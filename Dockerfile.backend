FROM golang:1.21-alpine AS builder

# 国内 Go 模块代理（构建环境无法直连 proxy.golang.org 时使用）
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=$GOPROXY
ENV GOSUMDB=sum.golang.google.cn

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY backend/ ./backend/

RUN cd backend && CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o fuze-scheduler ./cmd/main.go

# 固定 alpine 版本（latest 不可复现且可能含非预期行为变更）。
FROM alpine:3.19

RUN apk --no-cache add ca-certificates \
    && addgroup -S -g 10001 app \
    && adduser -S -D -H -u 10001 -G app app

# 以非 root 用户运行：降低容器逃逸与提权风险（安全基线）。
USER 10001:10001
WORKDIR /app

COPY --from=builder /app/backend/fuze-scheduler .

EXPOSE 8080

CMD ["./fuze-scheduler"]
