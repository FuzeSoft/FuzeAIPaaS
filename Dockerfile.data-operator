# data-operator：数据处理算子容器（清洗 / 增强 / ETL 内置算子）。
# 由 K8s/Volcano Job 启动，读取 FUZE_DATA_SPEC 环境变量分发到对应算子。
FROM golang:1.21-alpine AS builder

ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=$GOPROXY
ENV GOSUMDB=sum.golang.google.cn

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY backend/ ./backend/

RUN cd backend && CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o data-operator ./cmd/data-operator

# 固定 alpine 版本。
FROM alpine:3.19

RUN apk --no-cache add ca-certificates \
    && addgroup -S -g 10003 app \
    && adduser -S -D -H -u 10003 -G app app

# 以非 root 用户运行（安全基线）。
USER 10003:10003
WORKDIR /app

COPY --from=builder /app/backend/data-operator .

# 注：实际部署镜像地址应与 backend/internal/domain/data/operator.go 中
# builtinImage 常量保持一致（registry.local/fuze/data-operator:latest），
# 也可由运维覆盖镜像 tag。
ENTRYPOINT ["./data-operator"]
